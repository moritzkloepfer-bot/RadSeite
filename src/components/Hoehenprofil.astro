---
import type { ProfilPunkt } from '../lib/gpx';

interface Props {
  profil: ProfilPunkt[];
  status: 'geplant' | 'gefahren';
}
const { profil, status } = Astro.props;

const B = 1000;
const H = 200;
const minEle = profil.length ? Math.min(...profil.map((p) => p.ele)) : 0;
const maxEle = profil.length ? Math.max(...profil.map((p) => p.ele)) : 1;
// Achse auf runde 50-m-Werte, mit etwas Luft
const unten = Math.max(0, Math.floor((minEle - 20) / 50) * 50);
const oben = Math.ceil((maxEle + 20) / 50) * 50;
const kmStart = profil[0]?.km ?? 0;
const kmEnde = profil[profil.length - 1]?.km ?? 1;
const x = (km: number) => ((km - kmStart) / (kmEnde - kmStart || 1)) * B;
const y = (ele: number) => H - ((ele - unten) / (oben - unten || 1)) * H;

const linie = profil.map((p, i) => `${i ? 'L' : 'M'}${x(p.km).toFixed(1)} ${y(p.ele).toFixed(1)}`).join(' ');
const flaeche = `${linie} L${B} ${H} L0 ${H} Z`;

const hoehenTicks = [unten, Math.round((unten + oben) / 2 / 50) * 50, oben];
const kmSchritt = [1, 2, 5, 10, 20, 25, 50].find((s) => (kmEnde - kmStart) / s <= 6) ?? 100;
const kmTicks: number[] = [];
for (let k = Math.ceil(kmStart / kmSchritt) * kmSchritt; k <= kmEnde; k += kmSchritt) kmTicks.push(k);

const daten = JSON.stringify(profil.map((p) => [p.km, p.ele, p.lat, p.lon]));
---

{
  profil.length > 1 && (
    <figure class="profil card" data-profil={daten} data-status={status}>
      <figcaption class="visually-hidden">
        Höhenprofil von {Math.round(minEle)} m bis {Math.round(maxEle)} m
      </figcaption>
      <div class="flaeche">
        <div class="y-achse" aria-hidden="true">
          {hoehenTicks.map((h) => (
            <span style={`top:${(y(h) / H) * 100}%`}>{h} m</span>
          ))}
        </div>
        <div class="plot">
          <svg viewBox={`0 0 ${B} ${H}`} preserveAspectRatio="none" aria-hidden="true">
            {hoehenTicks.map((h) => (
              <line x1="0" x2={B} y1={y(h)} y2={y(h)} class="gitter" />
            ))}
            <path d={flaeche} class="fuellung" />
            <path d={linie} class="kontur" vector-effect="non-scaling-stroke" />
          </svg>
          <div class="cursor" hidden>
            <div class="punkt" />
            <div class="info" />
          </div>
          <div class="x-achse" aria-hidden="true">
            {kmTicks.map((k) => (
              <span style={`left:${(x(k) / B) * 100}%`}>{k} km</span>
            ))}
          </div>
        </div>
      </div>
    </figure>
  )
}

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-profil]')) {
    const punkte: [number, number, number, number][] = JSON.parse(fig.dataset.profil!);
    const plot = fig.querySelector<HTMLElement>('.plot')!;
    const cursor = fig.querySelector<HTMLElement>('.cursor')!;
    const punkt = fig.querySelector<HTMLElement>('.punkt')!;
    const info = fig.querySelector<HTMLElement>('.info')!;
    const svg = plot.querySelector('svg')!;
    // Achsengrenzen aus den Achsenbeschriftungen ableiten
    const ticks = [...fig.querySelectorAll<HTMLElement>('.y-achse span')].map((s) => parseInt(s.textContent!, 10));
    const unten = Math.min(...ticks);
    const oben = Math.max(...ticks);

    const zeigen = (clientX: number) => {
      const r = svg.getBoundingClientRect();
      const f = Math.min(1, Math.max(0, (clientX - r.left) / r.width));
      const i = Math.round(f * (punkte.length - 1));
      const [km, ele, lat, lon] = punkte[i];
      cursor.hidden = false;
      cursor.style.left = `${f * 100}%`;
      punkt.style.top = `${(1 - (ele - unten) / (oben - unten)) * 100}%`;
      info.textContent = `${km.toLocaleString('de-DE', { maximumFractionDigits: 1 })} km · ${Math.round(ele)} m`;
      info.classList.toggle('links', f > 0.75);
      window.dispatchEvent(new CustomEvent('profil:hover', { detail: { lat, lon } }));
    };
    const ende = () => {
      cursor.hidden = true;
      window.dispatchEvent(new CustomEvent('profil:ende'));
    };
    plot.addEventListener('pointermove', (e) => zeigen(e.clientX));
    plot.addEventListener('pointerdown', (e) => zeigen(e.clientX));
    plot.addEventListener('pointerleave', ende);
  }
</script>

<style>
  .profil {
    margin: 0;
    padding: 1rem 1rem 0.5rem 0.5rem;
  }
  .flaeche {
    display: grid;
    grid-template-columns: 3.6rem 1fr;
  }
  .y-achse {
    position: relative;
    height: 180px;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .y-achse span {
    position: absolute;
    right: 0.5rem;
    transform: translateY(-50%);
    white-space: nowrap;
  }
  .plot {
    position: relative;
    touch-action: pan-y;
    cursor: crosshair;
  }
  svg {
    display: block;
    width: 100%;
    height: 180px;
    overflow: visible;
  }
  .gitter {
    stroke: var(--border);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .fuellung {
    fill: var(--accent);
    opacity: 0.18;
  }
  .kontur {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
  }
  [data-status='geplant'] .fuellung {
    fill: var(--geplant);
  }
  [data-status='geplant'] .kontur {
    stroke: var(--geplant);
  }
  .x-achse {
    position: relative;
    height: 1.6rem;
    font-size: 0.72rem;
    color: var(--muted);
  }
  .x-achse span {
    position: absolute;
    top: 0.35rem;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .cursor {
    position: absolute;
    top: 0;
    height: 180px;
    width: 0;
    border-left: 1px dashed var(--text);
    pointer-events: none;
  }
  .punkt {
    position: absolute;
    left: -6px;
    width: 12px;
    height: 12px;
    margin-top: -6px;
    border-radius: 50%;
    background: var(--text);
    border: 2px solid var(--surface);
  }
  .info {
    position: absolute;
    top: -0.6rem;
    left: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.1rem 0.4rem;
    white-space: nowrap;
  }
  .info.links {
    left: auto;
    right: 8px;
  }
</style>
